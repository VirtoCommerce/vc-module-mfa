<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.MFA</id>
  <version>3.1000.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1076.9</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Customer" version="3.1029.0" />
    <dependency id="VirtoCommerce.Notifications" version="3.1018.0" />
    <dependency id="VirtoCommerce.Store" version="3.1009.0" />
  </dependencies>

  <title>Multi-Factor Authentication</title>
  <description>Protects password sign-ins to the Backoffice and the storefront with a second factor: a one-time code sent by email. Enabled globally or per store.</description>

  <authors>
    <author>Virto Commerce</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-mfa</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.MFA)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.MFA.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.MFA.Web.Module, VirtoCommerce.MFA.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 Virto Commerce. All rights reserved</copyright>
  <tags>extension module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
